# Database (MongoDB replica set — needed for transactions)
MONGO_URL="mongodb://localhost:27017/gridpulse?replicaSet=rs0"

# Server
SERVER_PORT=3001

# Frontend
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Kaggle (for dataset download)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Open-Meteo (free, no key required)
# But you can configure the location for weather data
WEATHER_LATITUDE=18.52
WEATHER_LONGITUDE=73.85

# Simulation defaults
SIMULATION_TICK_MS=3000
SIMULATION_SPEED=1

# JWT Secret (required when NODE_ENV=production)
JWT_SECRET="change-this-to-a-random-string-in-production"

# Accounts created by `pnpm --filter @gridpulse/server seed` (local development only)
ADMIN_EMAIL=admin@gridpulse.test
ADMIN_PASSWORD=admin-dev-password
DEMO_USER_EMAIL=owner@gridpulse.test
DEMO_USER_PASSWORD=owner-dev-password
