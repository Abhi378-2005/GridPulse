# Database
DATABASE_URL="postgresql://gridpulse:gridpulse_dev@localhost:5432/gridpulse?schema=public"

# Server
SERVER_PORT=3001

# Frontend
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Kaggle (for dataset download)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Open-Meteo (free, no key required)
# But you can configure the location for weather data
WEATHER_LATITUDE=18.52
WEATHER_LONGITUDE=73.85

# Simulation defaults
SIMULATION_TICK_MS=3000
SIMULATION_SPEED=1
